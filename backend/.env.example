# F.R.I.D.A.Y. Environment Configuration Example
# Copy this file to .env and modify as needed

# App Settings
DEBUG=False
VERSION=1.5.0

# Ollama settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=phi3:mini
OLLAMA_TIMEOUT=60

# Runtime Paths (Change to your desired local storage)
RUNTIME_BASE=C:/Users/sayak/AI_RUNTIME

# Memory & Cognition
MEMORY_THRESHOLD=0.55
CONTEXT_WINDOW_SIZE=8
DECAY_ENABLED=True

# Voice & VAD
VAD_THRESHOLD=0.5
SILENCE_DURATION_MS=800

# Observability
ENABLE_TELEMETRY=True
EVENT_BUS_LOGGING=False
